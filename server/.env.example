# HTTP port for the mock API (4000 avoids every port RUNBOOK.md assigns)
PORT=4000

# Local infra from infra-compose.yml (mongo root/root on 27017)
MONGO_URI=mongodb://root:root@localhost:27017/uc1_demo_mock?authSource=admin

# Separate database used by `npm test` — wiped on every run
MONGO_URI_TEST=mongodb://root:root@localhost:27017/uc1_demo_mock_test?authSource=admin

# MANDATORY — accepted x-api-key values, comma-separated. The server refuses to
# start if this is empty. Never commit real keys; this file holds placeholders only.
# Generate one:
#   node -e "console.log('uc1_'+require('node:crypto').randomBytes(32).toString('base64url'))"
API_KEYS=replace-me-with-a-generated-key

# React console origin; * is fine for a local demo. Narrow this to the console's
# real origin once deployed.
CORS_ORIGIN=*

# error | warn | info | debug
LOG_LEVEL=info

# Pin the timezone used to render yyyyMMddHHmmss / yyyyMMdd
TZ=Asia/Phnom_Penh

# Longest accepted /ticket/create summary
MAX_SUMMARY_LENGTH=2000

# Demo levers: msisdns that force the FAILURE branches (comma-separated).
# Checked before the DB lookup, so a forced 500 beats a 404.
FORCE_BALANCE_ERROR_MSISDNS=85510999500
FORCE_TICKET_ERROR_MSISDNS=85510999500

# UC2 Branch A — recharge deep-link
# msisdns that force the send_link 500 branch (SMS gateway down)
FORCE_RECHARGE_ERROR_MSISDNS=85510999500
# Placeholder link format — the real one is an open item with Axiata
RECHARGE_LINK_BASE_URL=https://smart.com.kh/recharge
# How long a sent link stays valid
RECHARGE_LINK_TTL_HOURS=24
# Top-up ceiling; an amount above this is a 422. Axiata's real limit TBC.
MAX_TOPUP_AMOUNT=100
