# Config for `docker compose`. Copy to .env and fill in API_KEYS.
#
#   cp .env.example .env
#
# (Running without Docker? That uses server/.env instead — see server/.env.example.)

# MANDATORY — the key(s) your team calls the API with, comma-separated.
# Compose refuses to start without it. Generate one:
#   node -e "console.log('uc1_'+require('node:crypto').randomBytes(32).toString('base64url'))"
API_KEYS=

# Timezone for the yyyyMMddHHmmss timestamps and the ticketId date.
TZ=Asia/Phnom_Penh

# --- optional ---

# Point at a managed database (Atlas) instead of the bundled mongodb service.
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/uc1_demo_mock

# Password for the bundled MongoDB. Change it if this is reachable externally.
# MONGO_ROOT_PASSWORD=root

# Host ports. Change if 4000 or 27018 are already taken.
# API_HOST_PORT=4000
# MONGO_HOST_PORT=27018

# error | warn | info | debug
# LOG_LEVEL=info
